# Database (Supabase Postgres connection string)
DATABASE_URL=

# Supabase (Storage for images/crests + optional auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel (simple password gate — brief section 10)
ADMIN_PASSWORD=

# Sports API — using Football-Data.org (https://www.football-data.org)
# Free tier covers the Premier League; sign up for an API key there.
SPORTS_API_KEY=
SPORTS_API_BASE_URL=https://api.football-data.org/v4

# Cron endpoint protection (Vercel Cron auth header)
CRON_SECRET=

# Email (Resend, for newsletter + notifications)
RESEND_API_KEY=

# Google Indexing API service account (JSON, base64-encoded)
GOOGLE_INDEXING_SA_KEY=

# Impact/affiliate tracking code (also editable from the admin panel)
IMPACT_TRACKING_CODE=

# Analytics & tracking (all optional — features stay off until filled in)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Full site URL (no trailing slash) — used by sitemap.xml, robots.txt, and Open Graph tags
NEXT_PUBLIC_SITE_URL=https://passgoal.com
